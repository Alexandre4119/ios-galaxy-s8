--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -512,6 +512,23 @@
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
 
+#if defined(A50_BUILD)
+	/* XNU entry reached */
+	MOV64	x10, (A5_FB_PHYS + 300 * A5_FB_STRIDE + 240 * 4)
+	MOV64	x11, 0xffff0000
+	mov	x12, #21
+	mov	x15, #A5_FB_STRIDE
+1:	mov	x14, x10
+	mov	x13, #36
+2:	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	2b
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	1b
+	dsb	sy
+#endif
+
 	mov		x20, x0
 	mov		x21, #0
 
@@ -729,6 +746,24 @@
 	str		x11, [x12], #(1 << TTE_SHIFT)
 	subs	x13, x13, #1
 	b.ne	La5_fb_attr
+
+#if defined(A50_BUILD)
+	/* framebuffer bootstrap map built */
+	MOV64	x10, (A5_FB_PHYS + 340 * A5_FB_STRIDE + 240 * 4)
+	MOV64	x11, 0xffff8000
+	mov	x12, #21
+	mov	x15, #A5_FB_STRIDE
+1:	mov	x14, x10
+	mov	x13, #36
+2:	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	2b
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	1b
+	dsb	sy
+#endif
+
 #endif
 
 #if defined(SWEET) && !defined(A5XELTE)
@@ -890,6 +925,24 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(A50_BUILD)
+	/* MMU + framebuffer write OK */
+	MOV64	x10, (A5_FB_PHYS + 360 * A5_FB_STRIDE + 240 * 4)
+	MOV64	x11, 0xffff00ff
+	mov	x12, #21
+	mov	x15, #A5_FB_STRIDE
+1:	mov	x14, x10
+	mov	x13, #36
+2:	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	2b
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	1b
+	dsb	sy
+#endif
+
+
 #if defined(A5XELTE)
 	/* Blue block: the 4 KiB MMU is active and the framebuffer alias works. */
 	MOV64	x10, (A5_FB_PHYS + 120 * A5_FB_STRIDE + 240 * 4)
@@ -907,6 +960,28 @@
 	subs	x12, x12, #1
 	b.ne	La5_mmu_row
 	dsb		sy
+
+#if defined(A50_BUILD)
+	/* blue post-MMU marker survived */
+	MOV64	x10, (A5_FB_PHYS + 380 * A5_FB_STRIDE + 240 * 4)
+	MOV64	x11, 0xffffffff
+	mov	x12, #21
+	mov	x15, #A5_FB_STRIDE
+1:	mov	x14, x10
+	mov	x13, #36
+2:	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	2b
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	1b
+	dsb	sy
+#endif
+
+#if defined(A50_BUILD)
+9:	b	9b				/* controlled diagnostic stop */
+#endif
+
 	/* Preserve the arm_init KVA return address across the text routine. */
 	mov	x17, lr
 	adr	x0, La5_text_mmu
