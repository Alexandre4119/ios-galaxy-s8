diff --git bsd/dev/sweet_acpm.c bsd/dev/sweet_acpm.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_acpm.c
@@ -0,0 +1,383 @@
+/*
+ * Exynos 8895 (dreamlte/S8): the always-on power management core (APM) and its ACPM firmware, asked from the kernel.
+ * This is how the GPU driver (sweet_mali.c) reaches the PMIC's BUCK6 (vdd_g3d) to raise the G3D rail before the GPU
+ * is touched. Polled; one request at a time (a lock inside); thread context only.
+ *
+ * WHERE THIS COMES FROM. Adapted from HakiOS's Exynos 9810 (Galaxy S9+) ACPM driver
+ * (github.com/danstronics/ios-s9plus-exynos, core/drivers/core/hakios.exynos_acpm.c), itself under the Apple Public
+ * Source License 2.0 as this tree's drivers are. The mailbox/SRAM IPC protocol (channel discovery from the firmware's
+ * own table, the request/answer queues, the PMIC command words) is generic across this generation of Exynos SoCs and
+ * is kept as-is; only the addresses below are this phone's own, taken from the real Exynos 8895 downstream kernel
+ * (github.com/sonsation/kernel_dreamlte):
+ *   mailbox      0x16440000 (the device tree's acpm_ipc, "AP2APM MAILBOX")           -- 9810's was 0x14100000
+ *   APM SRAM     0x16500000, 0xB400 bytes (the same node, "APM SRAM")                -- 9810's was 0x02039000, 0x30000
+ *   initdata     +0x2850 (the device tree's acpm_ipc initdata-base)                  -- 9810's was 0x7F00
+ *   PMIC channel 2 (the device tree's speedy@15B50000/s2mps17mfd, acpm-ipc-channel)  -- same channel number as 9810
+ * The first three pages of the SRAM faulting when touched (SRAM_FIRST below) is carried over from the 9810 port as a
+ * conservative default; it has not been independently confirmed on this phone's APM.
+ *
+ * The DVFS and cpufreq-governor and ACPM-stop pieces of the original are left out here: this driver exists only to
+ * raise the GPU's rail (see sweet_mali.c). Pull them over from the original if they are needed later.
+ *
+ * Status: written, not yet run on the phone.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(DREAMLTE)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+
+#define MBOX_PA         0x16440000UL    /* dreamlte's "AP2APM MAILBOX" */
+#define MBOX_INTGR0     0x08
+#define MBOX_INTCR1     0x20
+#define MBOX_INTMR1     0x24
+#define MBOX_INTSR1     0x28
+#define SRAM_PA         0x16500000UL    /* dreamlte's "APM SRAM" */
+#define SRAM_SIZE       0xB400
+#define SRAM_FIRST      0x3000          /* carried over from the 9810 port; not confirmed on this phone */
+#define INITDATA        0x2850          /* dreamlte's device tree: acpm_ipc { initdata-base = <0x2850>; } */
+
+#define ID_CHANNELS     0x08
+#define ID_NCHANNELS    0x0C
+#define ID_AP_MAX       0x18
+#define ID_BUILD        0x6C
+
+#define CH_SIZE         0x48
+#define CH_ID           0x00
+#define CH_OWNER        0x08
+#define CH_TYPE         0x0C
+#define CH_IN_REAR      0x10
+#define CH_IN_FRONT     0x14
+#define CH_IN_BASE      0x18
+#define CH_OUT_REAR     0x28
+#define CH_OUT_FRONT    0x2C
+#define CH_OUT_BASE     0x30
+#define CH_QLEN         0x34
+#define CH_ELEM         0x38
+#define CH_AP_POLL      0x44
+
+#define SEQ_SHIFT       16
+#define SEQ_MASK        (0x3Fu << SEQ_SHIFT)
+#define ROOM_US         20000
+#define ANSWER_US       600000
+#define SENDS           3
+#define BUFFER_US       1000000
+#define POLL_US         50
+#define CHANNELS_MOST   16
+
+#define SWEET_ACPM_CH_PMIC      2       /* dreamlte's speedy@15B50000/s2mps17mfd, acpm-ipc-channel = <2> */
+#define SWEET_ACPM_PMIC_PMIC    1       /* the S2MPS17's own block ("type"); matches the 9810 port's convention */
+
+static vm_offset_t mbox, sram;
+static struct channel {
+	bool usable, buffer;
+	uint32_t in_rear, in_front, in_base, out_rear, out_front, out_base, len, elem;
+	uint32_t seq;
+} channels[CHANNELS_MOST];
+
+static LCK_GRP_DECLARE(sweet_acpm_lock_group, "sweet-acpm");
+static LCK_MTX_DECLARE(sweet_acpm_lock, &sweet_acpm_lock_group);
+static bool acpm_ready, acpm_tried;
+
+static uint64_t
+deadline_us(uint64_t us)
+{
+	uint64_t interval;
+
+	nanoseconds_to_absolutetime(us * NSEC_PER_USEC, &interval);
+	return mach_absolute_time() + interval;
+}
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static inline bool
+sram_ok(uint32_t off, uint32_t bytes)
+{
+	return off >= SRAM_FIRST && off <= SRAM_SIZE && bytes <= SRAM_SIZE - off && (off & 3) == 0;
+}
+
+static inline uint32_t
+srd(uint32_t off)
+{
+	return rd(sram, off - SRAM_FIRST);
+}
+
+static inline void
+swr(uint32_t off, uint32_t v)
+{
+	wr(sram, off - SRAM_FIRST, v);
+}
+
+static bool
+printable(uint32_t off, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		uint8_t c = (uint8_t)(srd((off + i) & ~3u) >> (8 * ((off + i) & 3)));
+
+		if (c == 0) {
+			return i > 0;
+		}
+		if (c < 0x20 || c > 0x7e) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+copy_string(uint32_t off, char *out, uint32_t len)
+{
+	uint32_t i;
+
+	for (i = 0; i + 1 < len; i++) {
+		char c = (char)(srd((off + i) & ~3u) >> (8 * ((off + i) & 3)));
+
+		if (c == 0) {
+			break;
+		}
+		out[i] = c;
+	}
+	out[i] = 0;
+}
+
+static void
+drain(struct channel *c, uint32_t id)
+{
+	uint32_t front = srd(c->out_front);
+
+	if (front < c->len && srd(c->out_rear) != front) {
+		swr(c->out_rear, front);
+	}
+	wr(mbox, MBOX_INTCR1, 1u << id);
+}
+
+static bool
+acpm_setup(void)
+{
+	uint32_t table, count, ap_max;
+	char version[26], built[26];
+
+	mbox = ml_io_map(MBOX_PA, 0x1000);
+	sram = ml_io_map(SRAM_PA + SRAM_FIRST, SRAM_SIZE - SRAM_FIRST);
+	if (mbox == 0 || sram == 0) {
+		printf("SWEET ACPM: cannot map the mailbox (%#lx) or the APM's SRAM (%#lx)\n", MBOX_PA, SRAM_PA + SRAM_FIRST);
+		return false;
+	}
+	if (!printable(INITDATA + ID_BUILD, 25)) {
+		printf("SWEET ACPM: no firmware's table at SRAM +%#x (its version string is not text): not used\n", INITDATA);
+		return false;
+	}
+	copy_string(INITDATA + ID_BUILD, version, sizeof(version));
+	copy_string(INITDATA + ID_BUILD + 25, built, sizeof(built));
+	table = srd(INITDATA + ID_CHANNELS);
+	count = srd(INITDATA + ID_NCHANNELS);
+	ap_max = srd(INITDATA + ID_AP_MAX);
+	printf("SWEET ACPM: firmware \"%s\" built \"%s\"; %u channels at SRAM +%#x, %u the AP's\n", version, built, count,
+	    table, ap_max);
+	if (ap_max > count || count > 64 || !sram_ok(table, count * CH_SIZE)) {
+		printf("SWEET ACPM: the channel table is not where it may be read: not used\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < ap_max; i++) {
+		uint32_t at = table + i * CH_SIZE, id = srd(at + CH_ID) & 0xff;
+		struct channel *c;
+		struct channel n = { 0 };
+
+		n.in_rear = srd(at + CH_IN_REAR);
+		n.in_front = srd(at + CH_IN_FRONT);
+		n.in_base = srd(at + CH_IN_BASE);
+		n.out_rear = srd(at + CH_OUT_REAR);
+		n.out_front = srd(at + CH_OUT_FRONT);
+		n.out_base = srd(at + CH_OUT_BASE);
+		n.len = srd(at + CH_QLEN);
+		n.elem = srd(at + CH_ELEM);
+		n.buffer = n.len <= 1;
+		if (id >= CHANNELS_MOST) {
+			continue;
+		}
+		if (n.buffer) {
+			n.usable = sram_ok(n.in_base, 16) && sram_ok(n.out_base, 16);
+		} else {
+			n.usable = n.len <= 64 && n.elem >= 16 && n.elem <= 256 && sram_ok(n.in_rear, 4) &&
+			    sram_ok(n.in_front, 4) && sram_ok(n.out_rear, 4) && sram_ok(n.out_front, 4) &&
+			    sram_ok(n.in_base, n.len * n.elem) && sram_ok(n.out_base, n.len * n.elem);
+		}
+		if (!n.usable) {
+			continue;
+		}
+		c = &channels[id];
+		*c = n;
+		if (!c->buffer) {
+			drain(c, id);
+		}
+	}
+	printf("SWEET ACPM: the PMIC's channel (%u) %s\n", SWEET_ACPM_CH_PMIC,
+	    channels[SWEET_ACPM_CH_PMIC].usable ? "usable" : "NOT usable");
+	return channels[SWEET_ACPM_CH_PMIC].usable;
+}
+
+bool
+sweet_acpm_init(void)
+{
+	bool ready;
+
+	lck_mtx_lock(&sweet_acpm_lock);
+	if (!acpm_tried) {
+		acpm_tried = true;
+		acpm_ready = acpm_setup();
+	}
+	ready = acpm_ready;
+	lck_mtx_unlock(&sweet_acpm_lock);
+	return ready;
+}
+
+static bool
+take_answer(struct channel *c, uint32_t id, uint32_t seq, uint32_t cmd[4])
+{
+	uint32_t rear = srd(c->out_rear), front = srd(c->out_front);
+	bool found = false;
+
+	if (rear >= c->len || front >= c->len || (rear == front && !(rd(mbox, MBOX_INTSR1) & (1u << id)))) {
+		return false;
+	}
+	for (uint32_t i = rear; i != front; i = (i + 1) % c->len) {
+		uint32_t slot = c->out_base + i * c->elem;
+
+		if (((srd(slot) & SEQ_MASK) >> SEQ_SHIFT) == seq) {
+			for (uint32_t w = 0; w < 4; w++) {
+				cmd[w] = srd(slot + 4 * w);
+			}
+			found = true;
+		}
+	}
+	drain(c, id);
+	return found;
+}
+
+static int
+request_queue(struct channel *c, uint32_t id, uint32_t cmd[4])
+{
+	uint32_t sent[4], front, next;
+	uint64_t deadline;
+
+	for (uint32_t w = 0; w < 4; w++) {
+		sent[w] = cmd[w];
+	}
+	for (int send = 0; send < SENDS; send++) {
+		drain(c, id);
+		front = srd(c->in_front);
+		if (front >= c->len) {
+			return EIO;
+		}
+		next = (front + 1) % c->len;
+		for (deadline = deadline_us(ROOM_US); srd(c->in_rear) == next && mach_absolute_time() < deadline;) {
+			delay(POLL_US);
+		}
+		if (srd(c->in_rear) == next) {
+			continue;
+		}
+		c->seq = c->seq % 63 + 1;
+		sent[0] = (sent[0] & ~SEQ_MASK) | c->seq << SEQ_SHIFT;
+		for (uint32_t w = 0; w < 4; w++) {
+			swr(c->in_base + front * c->elem + 4 * w, sent[w]);
+		}
+		__builtin_arm_dsb(0xf);
+		swr(c->in_front, next);
+		__builtin_arm_dsb(0xf);
+		wr(mbox, MBOX_INTGR0, 1u << (16 + id));
+		for (deadline = deadline_us(ANSWER_US); mach_absolute_time() < deadline;) {
+			if (take_answer(c, id, c->seq, cmd)) {
+				return 0;
+			}
+			delay(POLL_US);
+		}
+		if (take_answer(c, id, c->seq, cmd)) {
+			return 0;
+		}
+	}
+	return ETIMEDOUT;
+}
+
+static int
+request_buffer(struct channel *c, uint32_t id, uint32_t cmd[4])
+{
+	uint64_t deadline;
+
+	c->seq = c->seq % 63 + 1;
+	cmd[0] = (cmd[0] & ~SEQ_MASK) | c->seq << SEQ_SHIFT;
+	wr(mbox, MBOX_INTCR1, 1u << id);
+	for (uint32_t w = 0; w < 4; w++) {
+		swr(c->in_base + 4 * w, cmd[w]);
+	}
+	__builtin_arm_dsb(0xf);
+	wr(mbox, MBOX_INTGR0, 1u << (16 + id));
+	for (deadline = deadline_us(BUFFER_US); !(rd(mbox, MBOX_INTSR1) & (1u << id));) {
+		if (mach_absolute_time() >= deadline) {
+			return ETIMEDOUT;
+		}
+		delay(POLL_US);
+	}
+	for (uint32_t w = 0; w < 4; w++) {
+		cmd[w] = srd(c->out_base + 4 * w);
+	}
+	wr(mbox, MBOX_INTCR1, 1u << id);
+	return 0;
+}
+
+static int
+sweet_acpm_request(uint32_t id, uint32_t cmd[4])
+{
+	int error;
+
+	if (!acpm_ready || id >= CHANNELS_MOST || !channels[id].usable) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_acpm_lock);
+	error = channels[id].buffer ? request_buffer(&channels[id], id, cmd) : request_queue(&channels[id], id, cmd);
+	lck_mtx_unlock(&sweet_acpm_lock);
+	return error;
+}
+
+int
+sweet_acpm_pmic_read(uint32_t reg, uint8_t *value)
+{
+	uint32_t cmd[4] = { (SWEET_ACPM_PMIC_PMIC & 0xf) << 8 | (reg & 0xff), 0, 0, 0 };
+	int error = sweet_acpm_request(SWEET_ACPM_CH_PMIC, cmd);
+
+	if (error == 0 && (cmd[1] >> 24) != 0) {
+		error = EIO;
+	}
+	if (error == 0) {
+		*value = (uint8_t)(cmd[1] >> 8);
+	}
+	return error;
+}
+
+int
+sweet_acpm_pmic_write(uint32_t reg, uint8_t value)
+{
+	uint32_t cmd[4] = { (SWEET_ACPM_PMIC_PMIC & 0xf) << 8 | (reg & 0xff), 1u | (uint32_t)value << 8, 0, 0 };
+	int error = sweet_acpm_request(SWEET_ACPM_CH_PMIC, cmd);
+
+	return error == 0 && (cmd[1] >> 24) != 0 ? EIO : error;
+}
+
+#endif /* DREAMLTE */
diff --git bsd/dev/sweet_mali.c bsd/dev/sweet_mali.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_mali.c
@@ -0,0 +1,515 @@
+/*
+ * The GPU of the Galaxy S8 (dreamlte, Exynos 8895), a Mali-G71 MP20, brought up from the kernel step by step. Only
+ * with boot-arg mali=N: every address below belongs to this phone, and nothing is touched without it.
+ *
+ * WHERE THIS COMES FROM. Adapted from HakiOS's Exynos 9810 (Galaxy S9+) Mali driver
+ * (github.com/danstronics/ios-s9plus-exynos, core/drivers/gpu/hakios.mali.c), itself under the Apple Public Source
+ * License 2.0 as this tree's drivers are, and itself adapted from a MediaTek Mali-G52 driver before that. A Bifrost
+ * Mali needs no firmware: bringing it up is a supply, a clock and power, then its own registers, which are Linux
+ * panfrost's (drivers/gpu/drm/panfrost/panfrost_regs.h) and the same on a G71 as on a G72 for all that is used here.
+ *
+ * WHAT IS THIS PHONE'S OWN, taken from the real Exynos 8895 downstream kernel (github.com/sonsation/kernel_dreamlte),
+ * replacing the 9810 port's addresses:
+ *   registers    0x13900000, 0x5000 bytes (the device tree's mali@13900000)                 -- 9810's was 0x17500000
+ *   interrupts   SPI 60 job, 61 MMU, 59 GPU (the device tree's mali node)                    -- 9810's 282/281/283
+ *   GPU_ID       a G71 reads architecture 6.x, product 0 ("tMIx"; GPU_ID2_PRODUCT_TMIX =
+ *                GPU_ID2_MODEL_MAKE(6, 0) in Samsung's own kbase source, mali_kbase_gpu_id.h) -- so
+ *                (GPU_ID >> 16) & 0xf00f should read 0x6000, where the 9810's G72 ("tHEx", product 1) reads 0x6001.
+ *                The exact architecture-minor/revision nibbles are not pinned down further, as the 9810 driver does
+ *                not pin them down for the G72 either
+ *   shader cores community dreamlte kernels' G71 MP20 default core mask is 0x17771777 (read at runtime from
+ *                SHADER_PRESENT below; not hard-coded, only noted here for a sanity check against the log)
+ *   power domain PMU_ALIVE (0x16480000, the SAME block the CPU bring-up in SweetCPU.cpp maps for the Mongoose/A53
+ *                power-up): pd-g3d's configuration at +0x40E0, [3:0] = 0xF asks it on, status at +0x40E4, [3:0] = 0xF
+ *                when it is (github.com/sonsation/kernel_dreamlte, exynos8895-pm-domains.dtsi's pd_g3d and the mali
+ *                node's gpu_pmu_status_reg_offset = <0x40E4>, gpu_pmu_status_local_pwr_mask = <0xF>)
+ *   clock        CMU_G3D (0x13800000, outside the domain): PLL_LOCKTIME at +0x0, the mux
+ *                (MUX_CLKCMU_G3D_SWITCH_USER) at +0x100, PLL_CON0_PLL_G3D at +0x120 (cmucal-sfr.c). PLL_CON2_PLL_G3D
+ *                is ASSUMED at +0x128 (CON0 + 8, the same spacing the 9810's PLL_G3D block uses between its own
+ *                CON0/CON2) -- NOT independently confirmed in the downstream source; the first test should watch
+ *                for this specifically (pll_say() logs PLL_CON2 every time). The PLL itself is a PLL_1052X, not the
+ *                9810's PLL_1018X: the M/P/S limits may differ, so mali_mhz's rate table below is NOT carried over
+ *                from the 9810 port and instead just leaves the PLL at whatever S-Boot set (mali_pll=0 is the
+ *                effective default here until a real rate table is worked out for PLL_1052X)
+ *   bus dividers MUX_CLK_G3D_BUSD at CMU_G3D +0x1000 (cmucal-sfr.c); DIV_CLK_G3D_BUSP at +0x1804 (cmucal-sfr.c,
+ *                confirmed). DIV_CLK_G3D_BUSD is ASSUMED at +0x1800 (the 9810 port's spacing; not independently
+ *                confirmed for the 8895)
+ *   DTZPC        the TrustZone protection-controller SMC the 9810 port makes after a power-on (SMC 0x82000410,
+ *                Samsung's SMC_CMD_PREPARE_PD_ONOFF, with the G3D's own protection-controller address) has NOT been
+ *                found in the downstream 8895 source for this port: step_dtzpc below is left a no-op (always true)
+ *                until that address is found or the domain is shown to need no DTZPC at all on this SoC generation.
+ *                If the GPU is unreadable after step 2's power-on (step 4 never finds a GPU_ID), this is the first
+ *                place to look
+ *   supply       the S2MPS17's BUCK6, vdd_g3d (dreamlte uses an S2MPS17, not the 9810's S2MPS18): B6CTRL at PMIC
+ *                register 0x23 ([7:6]: 11 always on, 10 the G3D power pin's/g3d_en, 00 off -- the same meaning as the
+ *                9810's B6CTRL, per the downstream driver's "BUCK6 is controlled by g3d gpio" comment), B6OUT1 at
+ *                0x24, 300 mV + 6.25 mV a step (S2MPS17_BUCK_MIN1/STEP1, same formula as the 9810's S2MPS18). This
+ *                phone's device tree caps vdd_g3d at 850 mV (0x58), not the 9810's 950 mV (0x68)
+ *   coherency    none: same as the 9810 port; COHERENCY_ENABLE = 31 after every reset
+ *
+ * WHAT IS LEFT OUT OF THIS FIRST PASS, compared to the 9810 port: only steps 1-6 (look, power, dtzpc, GPU_ID, reset,
+ * cores) are here. Steps 7-9 (a test job in identity mode, a test job through the GPU's own page tables, and serving
+ * HakiosMali/an IOKit client) are NOT yet ported: they need the GPU's own MMU/page-table code and the IOKit service
+ * side (iokit/Kernel/hakios.mali.cpp in the reference, with no dreamlte equivalent yet), which is real additional
+ * work, not just address substitution, and is left for a second pass once steps 1-6 are shown to actually bring the
+ * GPU up on this phone.
+ *
+ * Boot-args:
+ *   mali=N           the first N of the GPU's six steps here (6: all of them, then left idle -- no step 9 yet);
+ *                     0 or none: left alone
+ *   mali_acpm=0      the rail not raised: the GPU is touched at the boot's voltage (a test only; likely hangs the
+ *                     SoC exactly as the 9810 port found, if the Exynos family's behavior here carries over)
+ *   mali_uv=UV       BUCK6 target in microvolts, 300000..850000 in 6250-uV steps (default 800000, this board's
+ *                     device-tree gpu_default_voltage)
+ *
+ * Status: written, not yet run on the phone. The register-level facts above come from the real downstream kernel
+ * source and from the 9810 port's own hardware testing; the two specifically flagged as ASSUMED (PLL_CON2_PLL_G3D,
+ * DIV_CLK_G3D_BUSD) and the missing DTZPC address have not themselves been tested on this phone.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(DREAMLTE)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern bool sweet_acpm_init(void);
+extern int sweet_acpm_pmic_read(uint32_t reg, uint8_t *value);
+extern int sweet_acpm_pmic_write(uint32_t reg, uint8_t value);
+
+#define PMU_PHYS                0x16480000UL     /* PMU_ALIVE: the same block SweetCPU.cpp maps for the CPU cores */
+#define PMU_SIZE                0x10000
+#define PMU_G3D_CONFIGURATION   0x40e0           /* pd_g3d: 0x164840e0 - 0x16480000 */
+#define PMU_G3D_STATUS          0x40e4
+#define G3D_ON                  0xfu
+#define G3D_WAIT_US             100000u
+
+#define CMU_G3D_PHYS            0x13800000UL
+#define CMU_G3D_SIZE            0x2000
+#define PLL_LOCKTIME            0x0000
+#define MUX_G3D_USER            0x0100           /* PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER */
+#define PLL_CON0                0x0120           /* PLL_CON0_PLL_G3D (cmucal-sfr.c, confirmed) */
+#define PLL_CON2                0x0128           /* ASSUMED: CON0 + 8, not independently confirmed (see header) */
+#define MUX_CLK_G3D_BUSD        0x1000           /* cmucal-sfr.c, confirmed */
+#define DIV_CLK_G3D_BUSD        0x1800           /* ASSUMED: see header */
+#define DIV_CLK_G3D_BUSP        0x1804           /* cmucal-sfr.c, confirmed */
+#define CLK_CON_BUSY            (1u << 16)
+#define MUX_SEL                 (1u << 4)
+#define MUX_BUSY                (1u << 7)
+#define PLL_ENABLE              (1u << 31)
+#define PLL_STABLE              (1u << 29)
+#define PLL_CON2_LOCK           0x30000003u
+#define PLL_CON2_OFF            0x10000001u
+#define MUX_BUSY_US             1000u
+#define PLL_STABLE_US           20000u
+
+#define MALI_PHYS               0x13900000UL
+#define MALI_SIZE               0x5000
+#define MALI_G71_MASK           0xf00fu          /* GPU_ID2_ARCH_MAJOR | GPU_ID2_PRODUCT_MAJOR, raw GPU_ID >> 16 */
+#define MALI_G71_WANT           0x6000u          /* arch_major 6, product_major 0: GPU_ID2_PRODUCT_TMIX */
+
+/* The B6CTRL/B6OUT1 offsets and the 300 mV + 6.25 mV-a-step formula are the S2MPS17's (see this file's header). */
+#define B6CTRL                  0x23
+#define B6OUT1                  0x24
+#define B6OUT_MOST              0x58             /* this board's regulator-max-microvolt, 850 mV, in 6.25-mV steps */
+#define RAIL_SETTLE_US          200
+#define RAIL_TRIES              10
+
+static uint32_t mali_n = 0;                      /* mali=N: boot-arg */
+static uint32_t mali_acpm = 1;
+static uint32_t mali_uv = 800000;                /* this board's gpu_default_voltage */
+static uint8_t b6out_target;
+
+static vm_offset_t pmu, cmu_g3d, mali;
+static uint32_t reached, gpu_id, shader_mask, l2_mask, step;
+static bool powered_here, acpm_ok, rail_changed, b6out_known;
+static uint8_t b6out_found;
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t at)
+{
+	return *(volatile uint32_t *)(base + at);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t at, uint32_t value)
+{
+	*(volatile uint32_t *)(base + at) = value;
+	__builtin_arm_dsb(0xf);
+}
+
+static bool
+wait_for(vm_offset_t base, uint32_t at, uint32_t mask, uint32_t want, uint32_t us)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &deadline);
+	deadline += mach_absolute_time();
+	while ((rd(base, at) & mask) != want) {
+		if (mach_absolute_time() >= deadline) {
+			return (rd(base, at) & mask) == want;
+		}
+	}
+	return true;
+}
+
+static void
+pause_us(uint32_t us)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &deadline);
+	deadline += mach_absolute_time();
+	while (mach_absolute_time() < deadline) {
+	}
+}
+
+/* ---- Mali/panfrost registers (same layout as the 9810 port; see its header) ---- */
+#define GPU_ID              0x000
+#define GPU_L2_FEATURES     0x004
+#define GPU_CORE_FEATURES   0x008
+#define GPU_TILER_FEATURES  0x00c
+#define GPU_MEM_FEATURES    0x010
+#define GPU_MMU_FEATURES    0x014
+#define GPU_AS_PRESENT      0x018
+#define GPU_JS_PRESENT      0x01c
+#define GPU_INT_RAWSTAT     0x020
+#define GPU_INT_CLEAR       0x024
+#define GPU_INT_MASK        0x028
+#define GPU_CMD             0x030
+#define SHADER_PRESENT      0x100
+#define SHADER_PRESENT_HI   0x104
+#define TILER_PRESENT       0x110
+#define L2_PRESENT          0x120
+#define SHADER_READY        0x140
+#define TILER_READY         0x150
+#define L2_READY            0x160
+#define SHADER_PWRON        0x180
+#define TILER_PWRON         0x190
+#define L2_PWRON            0x1a0
+#define COHERENCY_ENABLE    0x304
+#define COHERENCY_NONE      31u
+#define IRQ_RESET_COMPLETED (1u << 8)
+#define GPU_CMD_SOFT_RESET  1u
+#define GPU_CMD_HARD_RESET  2u
+#define GPU_L2_MMU_CONFIG   0xf0c
+#define L2_MMU_LIMIT_EXTERNAL (0xfu << 24)
+#define RESET_WAIT_US       100000
+#define CORES_WAIT_US       50000
+
+static bool
+gpu_reset(void)
+{
+	wr(mali, GPU_INT_MASK, 0);
+	wr(mali, GPU_INT_CLEAR, IRQ_RESET_COMPLETED);
+	wr(mali, GPU_CMD, GPU_CMD_SOFT_RESET);
+	if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, RESET_WAIT_US)) {
+		printf("SWEET MALI: the soft reset did not finish (GPU_INT_RAWSTAT %#x): a hard reset\n",
+		    rd(mali, GPU_INT_RAWSTAT));
+		wr(mali, GPU_CMD, GPU_CMD_HARD_RESET);
+		if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, RESET_WAIT_US)) {
+			return false;
+		}
+	}
+	wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr(mali, COHERENCY_ENABLE, COHERENCY_NONE);
+	wr(mali, GPU_L2_MMU_CONFIG, rd(mali, GPU_L2_MMU_CONFIG) & ~L2_MMU_LIMIT_EXTERNAL);
+	return true;
+}
+
+static bool
+gpu_cores_on(const char **which)
+{
+	uint32_t tiler = rd(mali, TILER_PRESENT);
+
+	wr(mali, L2_PWRON, l2_mask);
+	if (!wait_for(mali, L2_READY, l2_mask, l2_mask, CORES_WAIT_US)) {
+		*which = "the L2";
+		return false;
+	}
+	wr(mali, SHADER_PWRON, shader_mask);
+	if (!wait_for(mali, SHADER_READY, shader_mask, shader_mask, CORES_WAIT_US)) {
+		*which = "the shader cores";
+		return false;
+	}
+	wr(mali, TILER_PWRON, tiler);
+	if (!wait_for(mali, TILER_READY, tiler, tiler, CORES_WAIT_US)) {
+		*which = "the tiler";
+		return false;
+	}
+	return true;
+}
+
+/* ---- the rail (S2MPS17 BUCK6, over the sweet_acpm mailbox) ---- */
+
+static bool
+rail_read(const char *when, uint8_t *out)
+{
+	uint8_t ctrl = 0, vsel = 0;
+	int error = sweet_acpm_pmic_read(B6CTRL, &ctrl);
+
+	if (error == 0) {
+		error = sweet_acpm_pmic_read(B6OUT1, &vsel);
+	}
+	if (error != 0) {
+		printf("SWEET MALI: ACPM: BUCK6 (vdd_g3d) %s: NOT READ, error %d\n", when, error);
+		return false;
+	}
+	printf("SWEET MALI: ACPM: BUCK6 (vdd_g3d) %s: B6CTRL %#x ([7:6] = %u), B6OUT1 %#x = %u mV\n", when, ctrl,
+	    (ctrl >> 6) & 3, vsel, 300 + vsel * 25 / 4);
+	*out = vsel;
+	return true;
+}
+
+static bool
+rail_set(uint8_t vsel)
+{
+	uint8_t now = 0;
+
+	if (vsel > B6OUT_MOST) {
+		return false;
+	}
+	for (int attempt = 1; attempt <= RAIL_TRIES; attempt++) {
+		int error = sweet_acpm_pmic_write(B6OUT1, vsel);
+
+		if (error == 0) {
+			error = sweet_acpm_pmic_read(B6OUT1, &now);
+		}
+		if (error == 0 && now == vsel) {
+			pause_us(RAIL_SETTLE_US);
+			return true;
+		}
+		printf("SWEET MALI: ACPM: B6OUT1 = %#x, attempt %d of %d: %s %#x\n", vsel, attempt, RAIL_TRIES,
+		    error ? "error" : "it reads", error ? (unsigned)error : now);
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	return false;
+}
+
+/* ---- the steps ---- */
+
+static bool
+step_look(void)
+{
+	uint32_t status;
+
+	printf("SWEET MALI: 1: mapping the PMU (%#lx), CMU_G3D (%#lx) and the GPU (%#lx); nothing is written in this step\n",
+	    PMU_PHYS, CMU_G3D_PHYS, MALI_PHYS);
+	pmu = ml_io_map(PMU_PHYS, PMU_SIZE);
+	cmu_g3d = ml_io_map(CMU_G3D_PHYS, CMU_G3D_SIZE);
+	mali = ml_io_map(MALI_PHYS, MALI_SIZE);
+	if (pmu == 0 || cmu_g3d == 0 || mali == 0) {
+		printf("SWEET MALI: 1: cannot map them\n");
+		return false;
+	}
+	status = rd(pmu, PMU_G3D_STATUS);
+	printf("SWEET MALI: 1: G3D configuration %#x, status %#x: the domain is %s\n", rd(pmu, PMU_G3D_CONFIGURATION),
+	    status, (status & G3D_ON) == G3D_ON ? "on" : (status & G3D_ON) == 0 ? "off" : "NEITHER ON NOR OFF");
+	printf("SWEET MALI: 1: CMU_G3D +0x100 %#x, PLL_CON0 %#x, PLL_CON2 %#x, MUX_CLK_G3D_BUSD %#x, DIV_CLK_G3D_BUSP %#x\n",
+	    rd(cmu_g3d, MUX_G3D_USER), rd(cmu_g3d, PLL_CON0), rd(cmu_g3d, PLL_CON2), rd(cmu_g3d, MUX_CLK_G3D_BUSD),
+	    rd(cmu_g3d, DIV_CLK_G3D_BUSP));
+	printf("SWEET MALI: 1: the GPU's own registers are not read before step 2 has raised its supply\n");
+	if (mali_acpm && (acpm_ok = sweet_acpm_init())) {
+		b6out_known = rail_read("as found", &b6out_found);
+	} else if (mali_acpm) {
+		printf("SWEET MALI: 1: no ACPM: the rail cannot be raised, and step 2 will stop there\n");
+	}
+	return true;
+}
+
+static bool
+step_power(void)
+{
+	uint32_t status = rd(pmu, PMU_G3D_STATUS) & G3D_ON;
+
+	if (status != G3D_ON && status != 0) {
+		printf("SWEET MALI: 2: the domain is neither on nor off (status %#x): left alone\n", rd(pmu, PMU_G3D_STATUS));
+		return false;
+	}
+	if (!mali_acpm) {
+		printf("SWEET MALI: 2: mali_acpm=0: BUCK6 left as found -- the GPU will be touched at the boot's voltage\n");
+	} else if (!acpm_ok) {
+		printf("SWEET MALI: 2: no ACPM: BUCK6 cannot be raised; the GPU is not touched at the boot's voltage\n");
+		return false;
+	} else if (!b6out_known && !(b6out_known = rail_read("as found, read again", &b6out_found))) {
+		printf("SWEET MALI: 2: B6OUT1 cannot be read: not written either; the GPU is not touched at the boot's voltage\n");
+		return false;
+	} else if (b6out_found > b6out_target) {
+		printf("SWEET MALI: 2: the boot's BUCK6 is above the requested %u uV: no lowering under a running GPU\n", mali_uv);
+		return false;
+	} else if (b6out_found == b6out_target) {
+		printf("SWEET MALI: 2: B6OUT1 is %#x (%u mV) already: not written\n", b6out_found, 300 + b6out_found * 25 / 4);
+	} else {
+		printf("SWEET MALI: 2: ACPM: B6OUT1 = %#x (%u uV, was %#x), read back, then %u us\n", b6out_target, mali_uv,
+		    b6out_found, RAIL_SETTLE_US);
+		rail_changed = true;
+		if (!rail_set(b6out_target)) {
+			printf("SWEET MALI: 2: BUCK6 did not reach the selected %u uV: the GPU is not touched\n", mali_uv);
+			return false;
+		}
+	}
+	/* the clock: PLL_G3D left as S-Boot set it (no 8895 rate table yet -- see this file's header) */
+	if ((rd(cmu_g3d, PLL_CON0) & (PLL_ENABLE | PLL_STABLE)) != (PLL_ENABLE | PLL_STABLE)) {
+		printf("SWEET MALI: 2: PLL_G3D does not run (PLL_CON0 %#x): the GPU would have no clock\n", rd(cmu_g3d, PLL_CON0));
+		return false;
+	}
+	if (status == G3D_ON) {
+		printf("SWEET MALI: 2: the domain is on already: no power-on; it is left on whatever happens\n");
+		return true;
+	}
+	printf("SWEET MALI: 2: the power-on: PLL_CON2 = %#x (was %#x), PLL_CON0 |= MUX_SEL, CMU_G3D +0x100 |= bit 4\n",
+	    PLL_CON2_LOCK, rd(cmu_g3d, PLL_CON2));
+	powered_here = true;
+	wr(cmu_g3d, PLL_CON2, PLL_CON2_LOCK);
+	wr(cmu_g3d, PLL_CON0, rd(cmu_g3d, PLL_CON0) | MUX_SEL);
+	wr(cmu_g3d, MUX_G3D_USER, rd(cmu_g3d, MUX_G3D_USER) | MUX_SEL);
+	wr(pmu, PMU_G3D_CONFIGURATION, (rd(pmu, PMU_G3D_CONFIGURATION) & ~G3D_ON) | G3D_ON);
+	if (!wait_for(pmu, PMU_G3D_STATUS, G3D_ON, G3D_ON, G3D_WAIT_US)) {
+		printf("SWEET MALI: 2: the domain did not come up: status %#x after %u ms\n", rd(pmu, PMU_G3D_STATUS),
+		    G3D_WAIT_US / 1000);
+		return false;
+	}
+	printf("SWEET MALI: 2: the domain is on: status %#x\n", rd(pmu, PMU_G3D_STATUS));
+	return true;
+}
+
+/*
+ * 3: the bus dividers, and (if this port finds the real DTZPC address, see this file's header) the TrustZone
+ * protection restore. For now this step only sets the bus dividers and goes on: if the GPU is unreadable in step 4
+ * right after a fresh power-on, an un-restored DTZPC is the first thing to suspect.
+ */
+static bool
+step_dtzpc(void)
+{
+	if (!powered_here) {
+		printf("SWEET MALI: 3: the boot left the domain on: nothing done\n");
+		return true;
+	}
+	printf("SWEET MALI: 3: NO DTZPC CALL MADE (its address for this SoC is not yet known -- see this file's header); "
+	    "the bus dividers: MUX_CLK_G3D_BUSD = 0, DIV_CLK_G3D_BUSD = 0, DIV_CLK_G3D_BUSP = 3; were %#x, %#x, %#x\n",
+	    rd(cmu_g3d, MUX_CLK_G3D_BUSD), rd(cmu_g3d, DIV_CLK_G3D_BUSD), rd(cmu_g3d, DIV_CLK_G3D_BUSP));
+	wr(cmu_g3d, MUX_CLK_G3D_BUSD, 0);
+	wr(cmu_g3d, DIV_CLK_G3D_BUSD, 0);
+	wr(cmu_g3d, DIV_CLK_G3D_BUSP, 3);
+	if (!wait_for(cmu_g3d, DIV_CLK_G3D_BUSP, CLK_CON_BUSY, 0, MUX_BUSY_US)) {
+		printf("SWEET MALI: 3: DIV_CLK_G3D_BUSP still busy: %#x\n", rd(cmu_g3d, DIV_CLK_G3D_BUSP));
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_gpu(void)
+{
+	uint32_t as_present, js_present, tiler, shaders_hi;
+
+	printf("SWEET MALI: 4: reading GPU_ID at %#lx, the first read of the GPU\n", MALI_PHYS);
+	gpu_id = rd(mali, GPU_ID);
+	printf("SWEET MALI: 4: GPU_ID %#x: architecture %u.%u revision %u, product %u, version r%up%u\n", gpu_id,
+	    gpu_id >> 28, (gpu_id >> 24) & 0xf, (gpu_id >> 20) & 0xf, (gpu_id >> 16) & 0xf, (gpu_id >> 12) & 0xf,
+	    (gpu_id >> 4) & 0xff);
+	if (((gpu_id >> 16) & MALI_G71_MASK) != MALI_G71_WANT) {
+		printf("SWEET MALI: 4: not a Mali-G71 ((GPU_ID >> 16) & %#x should be %#x): nothing more is done with it\n",
+		    MALI_G71_MASK, MALI_G71_WANT);
+		return false;
+	}
+	shader_mask = rd(mali, SHADER_PRESENT);
+	shaders_hi = rd(mali, SHADER_PRESENT_HI);
+	tiler = rd(mali, TILER_PRESENT);
+	l2_mask = rd(mali, L2_PRESENT);
+	as_present = rd(mali, GPU_AS_PRESENT);
+	js_present = rd(mali, GPU_JS_PRESENT);
+	printf("SWEET MALI: 4: shader cores %#x (%u of them; above bit 31 %#x; the known-good dreamlte mask is 0x17771777), "
+	    "tiler %#x, L2 %#x; address spaces %#x, job slots %#x\n", shader_mask, __builtin_popcount(shader_mask),
+	    shaders_hi, tiler, l2_mask, as_present, js_present);
+	if (shader_mask == 0 || shaders_hi != 0) {
+		printf("SWEET MALI: 4: shader cores %#x:%08x: not going on\n", shaders_hi, shader_mask);
+		return false;
+	}
+	if (!(as_present & 1) || (js_present & 3) != 3 || tiler == 0 || l2_mask == 0) {
+		printf("SWEET MALI: 4: no address space 0, job slots 0 and 1, tiler or L2: not going on\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_reset(void)
+{
+	if (!gpu_reset()) {
+		printf("SWEET MALI: 5: GPU_ID %#x, but it did not finish a reset (GPU_INT_RAWSTAT %#x)\n", gpu_id,
+		    rd(mali, GPU_INT_RAWSTAT));
+		return false;
+	}
+	printf("SWEET MALI: 5: reset; COHERENCY_ENABLE reads %#x, L2_MMU_CONFIG %#x\n", rd(mali, COHERENCY_ENABLE),
+	    rd(mali, GPU_L2_MMU_CONFIG));
+	return true;
+}
+
+static bool
+step_cores(void)
+{
+	uint32_t tiler = rd(mali, TILER_PRESENT);
+	const char *which = NULL;
+
+	if (!gpu_cores_on(&which)) {
+		printf("SWEET MALI: 6: %s did not power up: L2 ready %#x, shaders %#x, tiler %#x\n", which,
+		    rd(mali, L2_READY), rd(mali, SHADER_READY), rd(mali, TILER_READY));
+		return false;
+	}
+	printf("SWEET MALI: 6: GPU_ID %#x (Mali-G71), %u shader cores %#x, tiler %#x, L2 %#x: all powered\n", gpu_id,
+	    __builtin_popcount(shader_mask), shader_mask, tiler, l2_mask);
+	return true;
+}
+
+static const struct {
+	const char *name;
+	bool (*make)(void);
+} steps[] = {
+	{ "what the boot left, read only", step_look },
+	{ "the supply and the power-on (the clock is left as found)", step_power },
+	{ "the bus dividers (no DTZPC call yet)", step_dtzpc },
+	{ "GPU_ID and what the GPU has", step_gpu },
+	{ "a reset", step_reset },
+	{ "the cores", step_cores },
+};
+#define STEPS ((uint32_t)(sizeof(steps) / sizeof(steps[0])))
+
+void sweet_mali_probe(void);
+void
+sweet_mali_probe(void)
+{
+	if (!PE_parse_boot_argn("mali", &mali_n, sizeof(mali_n)) || mali_n == 0) {
+		return;
+	}
+	if (mali_n > STEPS) {
+		mali_n = STEPS;
+	}
+	PE_parse_boot_argn("mali_acpm", &mali_acpm, sizeof(mali_acpm));
+	PE_parse_boot_argn("mali_uv", &mali_uv, sizeof(mali_uv));
+	if (mali_uv > B6OUT_MOST * 6250u + 300000u) {
+		mali_uv = B6OUT_MOST * 6250u + 300000u;
+	}
+	b6out_target = (uint8_t)((mali_uv - 300000u) * 4 / 25);
+	printf("SWEET MALI: mali=%u (of %u steps), mali_acpm=%u, mali_uv=%u (B6OUT1 target %#x)\n", mali_n, STEPS,
+	    mali_acpm, mali_uv, b6out_target);
+	for (step = 1; step <= mali_n; step++) {
+		printf("SWEET MALI: %u: %s\n", step, steps[step - 1].name);
+		if (!steps[step - 1].make()) {
+			printf("SWEET MALI: %u: did not succeed: stopping here (reached %u of %u)\n", step, step - 1, STEPS);
+			if (powered_here) {
+				wr(pmu, PMU_G3D_CONFIGURATION, rd(pmu, PMU_G3D_CONFIGURATION) & ~G3D_ON);
+			}
+			return;
+		}
+		reached = step;
+	}
+	printf("SWEET MALI: reached %u of %u steps\n", reached, STEPS);
+}
+
+#endif /* DREAMLTE */
